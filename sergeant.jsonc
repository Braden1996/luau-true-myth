{
  "$schema": "./.sergeant/schema.json",
  "plugins": [
    "ts",
    "bun",
    "oxlint",
    "astro",
    "luau",
    "lune",
    "woof",
    "wow",
    "actionlint",
    "zizmor",
    "lychee",
    "secrets",
  ],
  "packages": ["packages/libraries/*/*/*", "packages/runtimes/*"],
  "typescript": { "tsconfig": "repo" },
  "luau": {
    "target": "luau",
    "runtime": "lune",
    "strictLints": true,
  },
  "cache": {
    "untrackable": "degrade",
  },
  "boundaries": {
    "noUnitCycles": true,
  },
  "check": {
    "strict-lint": {
      "description": "Enforce Luau source conventions",
      "cache": true,
      "inputs": [
        "packages/libraries/**/*.luau",
        "packages/runtimes/cli/src/**/*.luau",
        "packages/runtimes/wow-bundle/src/**/*.luau",
        "tests/**/*.luau",
      ],
      "tools": ["lune"],
      "run": ["lune", "run", "packages/runtimes/cli/src/lint.effect"],
    },
    "banner-fresh": {
      "description": "Verify the committed banner",
      "cache": true,
      "inputs": [
        "packages/libraries/luau/pure/true-myth/src/**/*.luau",
        ".github/banner.svg",
        "packages/runtimes/cli/src/banner.effect.luau",
      ],
      "tools": ["lune"],
      "run": ["lune", "run", "packages/runtimes/cli/src/banner.effect", "--", "--check"],
    },
    "bundle-fresh": {
      "description": "Verify the committed Lua 5.1 release bundle",
      "cache": true,
      "inputs": [
        "packages/libraries/luau/pure/true-myth/src/**/*.luau",
        "LICENSE",
        "dist/TrueMyth.lua",
        "packages/runtimes/cli/src/build.effect.luau",
      ],
      "tools": ["lune"],
      "run": ["lune", "run", "packages/runtimes/cli/src/build.effect", "--", "--check"],
      "dependsOn": ["packages/runtimes/wow-bundle"],
    },
    "bundle-specs": {
      "description": "Test the committed Lua 5.1 bundle and API coverage",
      "cache": true,
      "inputs": ["dist/TrueMyth.lua", "packages/libraries/**/*.luau", "packages/runtimes/cli/src/test.effect.luau"],
      "tools": ["lune", "luajit"],
      "run": ["lune", "run", "packages/runtimes/cli/src/test.effect"],
    },
    "fixtures": {
      "description": "Verify passing and failing Luau compiler fixtures",
      "cache": true,
      "inputs": [
        ".luaurc",
        "tests/**/*",
        "packages/libraries/luau/pure/true-myth/src/**/*.luau",
        "packages/runtimes/cli/src/fixtures.effect.luau",
        "packages/runtimes/cli/src/fixtures/diagnostics.luau",
      ],
      "tools": ["lune", "luau-lsp"],
      "run": ["lune", "run", "packages/runtimes/cli/src/fixtures.effect"],
    },
  },
  "commands": {
    "bundle": {
      "description": "Regenerate the committed Lua 5.1 release bundle",
      "run": ["lune", "run", "packages/runtimes/cli/src/build.effect"],
    },
    "banner": {
      "description": "Regenerate .github/banner.svg",
      "run": ["lune", "run", "packages/runtimes/cli/src/banner.effect"],
    },
    "fixtures-update": {
      "description": "Refresh expected Luau diagnostics",
      "run": ["lune", "run", "packages/runtimes/cli/src/fixtures.effect", "--", "--update"],
    },
  },
}
