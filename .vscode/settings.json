{
  "luau-lsp.platform.type": "standard",
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.fflags.enableNewSolver": true,
  "luau-lsp.ignoreGlobs": ["dist/**", "tests/fail/**"],
  "files.exclude": {
    ".sergeant": true,
    ".build": true
  },
  "search.exclude": {
    "dist": true,
    "mise.lock": true
  },
  "editor.rulers": [120],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false
  },
  "json.schemas": [
    {
      "fileMatch": ["/sergeant.jsonc", "/sergeant.json"],
      "url": "./.sergeant/schema.json"
    },
    {
      "fileMatch": ["/**/sergeant.jsonc", "/**/sergeant.json", "!/sergeant.jsonc", "!/sergeant.json"],
      "url": "./.sergeant/schema.unit.json"
    },
    {
      "fileMatch": ["/sergeant.allow.jsonc", "/sergeant.allow.json"],
      "url": "./.sergeant/schema.allow.json"
    }
  ]
}
