{
  // luau-lsp: the standard (non-Roblox) platform and the new type solver, which the library's types require.
  "luau-lsp.platform.type": "standard",
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.fflags.enableNewSolver": true,
  // The negative fixtures are meant to have errors; scripts/fixtures checks them exactly.
  "luau-lsp.ignoreGlobs": ["dist/**", "tests/fail/**"],
  "files.exclude": { ".moon/cache": true, ".build": true },
  "search.exclude": { "dist": true, "mise.lock": true },
  "editor.rulers": [120],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false
  },
  "[markdown][json][jsonc][yaml][toml]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.formatOnSave": true
  }
}
