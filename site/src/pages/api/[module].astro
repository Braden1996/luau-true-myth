---
// One API page per module, generated from the doc comments in ../src (see src/lib/api/parse-luau.ts).
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { GetStaticPaths } from "astro";

import { loadModules } from "../../lib/api/modules.ts";
import type { ApiEntry, ApiModule } from "../../lib/api/parse-luau.ts";
import { renderDoc } from "../../lib/api/render-doc.ts";

export const getStaticPaths = (() =>
  loadModules().map((module) => ({
    params: { module: module.name.toLowerCase() },
    props: { module },
  }))) satisfies GetStaticPaths;

interface Props {
  readonly module: ApiModule;
}

const { module } = Astro.props;
const source = `https://github.com/Braden1996/luau-true-myth/blob/main/src/${module.name}.luau`;
const counts = [
  `${String(module.functions.length)} functions`,
  ...(module.types.length > 0 ? [`${String(module.types.length)} types`] : []),
].join(", ") + ".";
const anchor = (entry: ApiEntry): string => `${entry.kind}-${entry.name}`.toLowerCase();
const headings = [
  ...(module.types.length > 0 ? [{ depth: 2, slug: "types", text: "Types" }] : []),
  ...module.types.map((entry) => ({ depth: 3, slug: anchor(entry), text: entry.name })),
  { depth: 2, slug: "functions", text: "Functions" },
  ...module.functions.map((entry) => ({
    depth: 3,
    slug: anchor(entry),
    text: `${module.name}.${entry.name}`,
  })),
];
---

<StarlightPage
  frontmatter={{
    title: module.name,
    description: `API reference for luau-true-myth's ${module.name} module.`,
  }}
  headings={headings}
>
  <Fragment set:html={renderDoc(module.description)} />
  <p>
    Source: <a href={source}><code>src/{module.name}.luau</code></a>. {counts}
  </p>

  {
    module.types.length > 0 && (
      <>
        <h2 id="types">Types</h2>
        {module.types.map((entry) => (
          <section class="api-entry">
            <h3 id={anchor(entry)}>{entry.name}</h3>
            <Code code={entry.signature} lang="luau" />
            {entry.doc !== "" && <Fragment set:html={renderDoc(entry.doc)} />}
          </section>
        ))}
      </>
    )
  }

  <h2 id="functions">Functions</h2>
  {
    module.functions.map((entry) => (
      <section class="api-entry">
        <h3 id={anchor(entry)}>
          <code>
            {module.name}.{entry.name}
          </code>
        </h3>
        <Code code={entry.signature} lang="luau" />
        <Fragment set:html={renderDoc(entry.doc)} />
      </section>
    ))
  }
</StarlightPage>
